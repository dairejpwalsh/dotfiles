# ============================================================
# Ghostty — Balanced, Transparent, Split-Heavy
# ============================================================

# Typography
font-family = JetBrains Mono
font-size = 13
adjust-cell-height = 5%

# Automatically follow system light/dark appearance
theme = Catppuccin Mocha

# Transparency
background-opacity = 0.90
background-blur = true

# Apply transparency to backgrounds drawn by applications
# such as Neovim and tmux
background-opacity-cells = true

# Window spacing
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

# Cursor and mouse
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# 100 MB of scrollback per terminal surface
scrollback-limit = 100000000

# Prompt navigation and directory inheritance
shell-integration = detect

# ============================================================
# Split management
# ============================================================

# Create splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+enter=new_split:down

# Navigate splits with Vim-style keys
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Resize splits
keybind = ctrl+alt+h=resize_split:left,20
keybind = ctrl+alt+j=resize_split:down,20
keybind = ctrl+alt+k=resize_split:up,20
keybind = ctrl+alt+l=resize_split:right,20

# Split utilities
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+e=equalize_splits
