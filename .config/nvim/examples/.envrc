# direnv settings for a Python/geospatial project. Copy this file to the
# project root as .envrc and run `direnv allow`. Fish loads it on cd and
# unloads it when you leave the directory.

# Put the project's uv environment (created by `uv sync`) first on PATH, so
# python, pytest, BasedPyright (when Neovim is started here) and Molten
# kernels all use the same interpreter.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Private settings go in .env next to this file. Keep .env out of Git (add it
# to the project's .gitignore). For example:
#
#   DATABASE_URL=postgresql://me@localhost:5432/gis
#   DBUI_URL=postgresql://me@localhost:5432/gis
#   DBUI_NAME=gis
#
# DATABASE_URL is the default connection for :DB (vim-dadbod); DBUI_URL and
# DBUI_NAME add a named connection to :DBUI. Prefer ~/.pgpass for passwords.
dotenv_if_exists
